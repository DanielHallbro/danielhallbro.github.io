---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog — Daniel Hållbro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  </head>
  <body>
    <nav id="nav">
      <div class="nav-name"><a href="/">Daniel Hållbro</a></div>
      <a href="/" class="back"><i class="ti ti-arrow-left"></i> Back</a>
    </nav>

    <main>
    <div class="breadcrumb">
  <a href="/">home</a>
  <span>/</span>
  <span>blog</span>
</div>
      <div class="header">
        <div class="eyebrow">All posts</div>
        <h1>Blog</h1>
      </div>

      <div class="grid">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="blog-card">
            <div class="blog-card-top">
              <span class={`blog-tag tag-${post.data.tag.toLowerCase()}`}>{post.data.tag}</span>
              <div class="blog-meta"><span>{post.data.date}</span></div>
            </div>
            <p class="blog-title">{post.data.title}</p>
            <p class="blog-ingress">{post.data.description}</p>
            <div class="blog-card-overlay">
              <div class="blog-read">Read more <i class="ti ti-arrow-right" aria-hidden="true"></i></div>
            </div>
          </a>
        ))}
      </div>
    </main>
    <footer>
  <span>Daniel Hållbro · 2026</span>
  <div class="footer-links">
    <a href="https://github.com/DanielHallbro" target="_blank">GitHub</a>
    <a href="https://linkedin.com/in/danielhallbro" target="_blank">LinkedIn</a>
    <a href="mailto:daniel.hallbro@gmail.com">daniel.hallbro@gmail.com</a>
  </div>
</footer>
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 2rem;
  border-top: 0.5px solid #252a35;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: #252a35;
}

.footer-links {
  display: flex;
  gap: 1.5rem;
}

.footer-links a {
  color: #64748b;
  text-decoration: none;
  transition: color 0.15s;
}

.footer-links a:hover { color: #4ade80; }

@media (max-width: 640px) {
  footer { display: none; }
}

body {
  font-family: 'Inter', sans-serif;
  color: #e2e8f0;
  min-height: 100vh;
  background: radial-gradient(ellipse at 25% 40%, #0d1f16 0%, #0d0f14 65%) fixed;
  display: flex;
  flex-direction: column;
}

  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    border-bottom: 0.5px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  nav.scrolled {
    background: rgba(13,15,20,0.95);
    border-bottom-color: #252a35;
  }

  .nav-name a {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #e2e8f0;
    text-decoration: none;
  }

  .back {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s;
  }

  .back:hover { color: #4ade80; }

main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 2rem 5rem;
  flex: 1;
}

  .breadcrumb {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: #252a35;
  margin-bottom: 2rem;
}

.breadcrumb a { color: #64748b; text-decoration: none; }
.breadcrumb a:hover { color: #4ade80; }

  .header { margin-bottom: 2.5rem; }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #4ade80;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 600;
    color: #e2e8f0;
    letter-spacing: -0.02em;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }

  .blog-card {
    background: #161921;
    border: 0.5px solid #252a35;
    border-radius: 8px;
    padding: 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, background 0.2s ease;
    position: relative;
    overflow: hidden;
    min-height: 160px;
  }

  .blog-card:hover {
    border-color: #4ade80;
    background: #181d24;
  }

  .blog-card:hover p { opacity: 0.5; }

  .blog-card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.875rem 1.125rem;
    background: linear-gradient(to top, #161921 80%, transparent);
    display: flex;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .blog-card:hover .blog-card-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .blog-read {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    background: #4ade80;
    color: #0d0f14;
    font-weight: 500;
    font-family: 'Inter', sans-serif;
  }

  .blog-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .blog-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 3px;
    display: inline-block;
  }

  .tag-htb { color: #4ade80; background: rgba(74,222,128,0.08); }
  .tag-ctf { color: #4ade80; background: rgba(74,222,128,0.08); }
  .tag-event { color: #fb923c; background: rgba(251,146,60,0.08); }
  .tag-meetup { color: #38bdf8; background: rgba(56,189,248,0.08); }

  .blog-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #252a35;
  }

  .blog-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #e2e8f0;
    line-height: 1.3;
  }

  .blog-ingress {
    font-size: 12px;
    color: #64748b;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  });
</script>