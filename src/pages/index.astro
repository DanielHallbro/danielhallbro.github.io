<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
  font-family: 'Inter', sans-serif;
  color: #e2e8f0;
  min-height: 100vh;
  background: radial-gradient(ellipse at 25% 40%, #0d1f16 0%, #0d0f14 65%) fixed;
}

  main, nav {
    position: relative;
    z-index: 1;
  }

  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    border-bottom: 0.5px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  nav.scrolled {
    background: rgba(13,15,20,0.95);
    border-bottom-color: #252a35;
    backdrop-filter: blur(8px);
  }

  .nav-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #e2e8f0;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links a {
    font-size: 13px;
    color: #64748b;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: color 0.15s;
  }

  .nav-links a:hover { color: #4ade80; }

  .hero {
    padding: 5rem 2rem 4rem;
    max-width: 640px;
  }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #4ade80;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 42px;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .sub {
    font-size: 15px;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .sub span { color: #94a3b8; }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #4ade80;
    border: 0.5px solid #4ade80;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .cta:hover { background: rgba(74,222,128,0.08); }

  .section {
    padding: 3rem 2rem;
    border-top: 0.5px solid #252a35;
  }

  main {
  max-width: 1200px;
  margin: 0 auto;
}

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #4ade80;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }

.card {
  background: #161921;
  border: 0.5px solid #252a35;
  border-radius: 8px;
  padding: 1.125rem;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  overflow: hidden;
  min-height: 180px;
}
.card:hover {
  border-color: #4ade80;
  background: #181d24;
}
.card:hover p {
  opacity: 0.5;
}
.card:hover .techs {
  opacity: 0.4;
}
.card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0.875rem 1.125rem;
  background: linear-gradient(to top, #161921 80%, transparent);
  display: flex;
  gap: 0.625rem;
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
}

.card:hover .card-overlay {
  opacity: 1;
  pointer-events: auto;
}
.btn-overlay-primary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  padding: 0.375rem 0.75rem;
  border-radius: 4px;
  text-decoration: none;
  background: #4ade80;
  color: #0d0f14;
  font-weight: 500;
}
.btn-overlay-secondary {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  padding: 0.375rem 0.75rem;
  border-radius: 4px;
  text-decoration: none;
  color: #64748b;
  border: 0.5px solid #252a35;
}
.btn-overlay-secondary:hover { color: #e2e8f0; border-color: #64748b; }
.card-tag {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: #4ade80;
  background: rgba(74,222,128,0.08);
  padding: 2px 7px;
  border-radius: 3px;
  display: inline-block;
  margin-bottom: 0.625rem;
}
.card h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
  font-weight: 500;
  color: #e2e8f0;
  margin-bottom: 0.4rem;
}
.card p {
  font-size: 12px;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 0.875rem;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.techs { display: flex; gap: 4px; flex-wrap: wrap; }
.tech {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: #64748b;
  background: #0d0f14;
  border: 0.5px solid #252a35;
  padding: 1px 6px;
  border-radius: 3px;
}
.card-links { display: flex; gap: 6px; }
.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border: 0.5px solid #252a35;
  border-radius: 4px;
  color: #64748b;
  text-decoration: none;
  font-size: 14px;
  transition: border-color 0.2s, color 0.2s;
}

  .icon-btn:hover { border-color: #4ade80; color: #4ade80; }

.blog-card {
  background: #161921;
  border: 0.5px solid #252a35;
  border-radius: 8px;
  padding: 1.125rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  transition: border-color 0.2s ease, background 0.2s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
}

.blog-tag {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 3px;
  display: inline-block;
}

.blog-card:hover {
  border-color: #4ade80;
  background: #181d24;
}
.blog-card:hover p {
  opacity: 0.5;
}
.blog-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1rem 1.125rem;
  display: flex;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
  pointer-events: none;
}
.blog-card:hover .blog-card-overlay {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.blog-read {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  padding: 0.375rem 0.75rem;
  border-radius: 4px;
  background: #4ade80;
  color: #0d0f14;
  font-weight: 500;
  font-family: 'Inter', sans-serif;
  position: relative;
  z-index: 2;
}

  .tag-htb { color: #4ade80; background: rgba(74,222,128,0.08); }
  .tag-ctf { color: #4ade80; background: rgba(74,222,128,0.08); }
  .tag-event { color: #fb923c; background: rgba(251,146,60,0.08); }
  .tag-meetup { color: #38bdf8; background: rgba(56,189,248,0.08); }

  .blog-meta {
    display: flex;
    gap: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #252a35;
  }

  .blog-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #e2e8f0;
    line-height: 1.3;
  }

  .blog-ingress {
    font-size: 12px;
    color: #64748b;
    line-height: 1.55;
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .about > p {
    font-size: 14px;
    color: #64748b;
    line-height: 1.7;
  }

  .contact-links { display: flex; flex-direction: column; gap: 0.75rem; }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s;
  }

  .contact-link i { color: #4ade80; font-size: 15px; }
  .contact-link:hover { color: #94a3b8; }

  .all-link-wrap {
  display: flex;
  justify-content: flex-end;
  margin-top: 1.25rem;
  padding-top: 1rem;
  border-top: 0.5px solid #252a35;
}

.all-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: #64748b;
  text-decoration: none;
  letter-spacing: 0.05em;
  transition: color 0.15s;
}

.all-link:hover { color: #4ade80; }

.hamburger {
  display: none;
  background: none;
  border: 0.5px solid #252a35;
  border-radius: 4px;
  padding: 6px 8px;
  cursor: pointer;
  flex-direction: column;
  gap: 4px;
  align-items: center;
  justify-content: center;
}

.hamburger span {
  display: block;
  width: 18px;
  height: 1.5px;
  background: #94a3b8;
}

.mobile-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #161921;
  border-bottom: 0.5px solid #252a35;
  padding: 0.75rem 1.25rem 1rem;
  flex-direction: column;
  z-index: 19;
}

.mobile-menu.open { display: flex; }

.mobile-menu a {
  font-size: 14px;
  color: #64748b;
  text-decoration: none;
  padding: 0.75rem 0;
  border-bottom: 0.5px solid #252a35;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mobile-menu a:last-child { border-bottom: none; }
.mobile-menu a:hover { color: #4ade80; }

@media (max-width: 640px) {
  .nav-links { display: none; }
  .hamburger { display: flex; }
  .grid { grid-template-columns: 1fr; }
  .about { grid-template-columns: 1fr; }
  h1 { font-size: 28px; }
}
</style>

<script>
  const nav = document.getElementById('nav');
const hamburger = document.getElementById('hamburger');
const mobileMenu = document.getElementById('mobileMenu');

window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 20);
});

hamburger.addEventListener('click', () => {
  mobileMenu.classList.toggle('open');
});
</script>
