---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Projects — Daniel Hållbro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  </head>
  <body>
    <nav id="nav">
      <div class="nav-name"><a href="/">Daniel Hållbro</a></div>
      <a href="/" class="back"><i class="ti ti-arrow-left"></i> Back</a>
    </nav>

    <main>
      <div class="header">
        <div class="eyebrow">All projects</div>
        <h1>Projects</h1>
      </div>

      <div class="grid">
        {projects.map(project => (
          <div class="card">
            <div class="card-tag">{project.data.tag}</div>
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <div class="techs">
              {project.data.techs.map(tech => (
                <span class="tech">{tech}</span>
              ))}
            </div>
            <div class="card-overlay">
              <a href={`/projects/${project.id}`} class="btn-overlay-primary">View project <i class="ti ti-arrow-right"></i></a>
              <a href={project.data.github} target="_blank" class="btn-overlay-secondary"><i class="ti ti-brand-github"></i> GitHub</a>
            </div>
          </div>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', sans-serif;
    color: #e2e8f0;
    min-height: 100vh;
    background: radial-gradient(ellipse at 25% 40%, #0d1f16 0%, #0d0f14 65%) fixed;
  }

  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    border-bottom: 0.5px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  nav.scrolled {
    background: rgba(13,15,20,0.95);
    border-bottom-color: #252a35;
  }

  .nav-name a {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #e2e8f0;
    text-decoration: none;
  }

  .back {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s;
  }

  .back:hover { color: #4ade80; }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }

  .header {
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #4ade80;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 600;
    color: #e2e8f0;
    letter-spacing: -0.02em;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }

  .card {
    background: #161921;
    border: 0.5px solid #252a35;
    border-radius: 8px;
    padding: 1.125rem;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
    overflow: hidden;
    min-height: 180px;
  }

  .card:hover {
    border-color: #4ade80;
    background: #181d24;
  }

  .card:hover p { opacity: 0.5; }
  .card:hover .techs { opacity: 0.4; }

  .card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.875rem 1.125rem;
    background: linear-gradient(to top, #161921 80%, transparent);
    display: flex;
    gap: 0.625rem;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .card:hover .card-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .btn-overlay-primary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    text-decoration: none;
    background: #4ade80;
    color: #0d0f14;
    font-weight: 500;
  }

  .btn-overlay-secondary {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    padding: 0.375rem 0.75rem;
    border-radius: 4px;
    text-decoration: none;
    color: #64748b;
    border: 0.5px solid #252a35;
  }

  .btn-overlay-secondary:hover { color: #e2e8f0; border-color: #64748b; }

  .card-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #4ade80;
    background: rgba(74,222,128,0.08);
    padding: 2px 7px;
    border-radius: 3px;
    display: inline-block;
    margin-bottom: 0.625rem;
  }

  .card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #e2e8f0;
    margin-bottom: 0.4rem;
  }

  .card p {
    font-size: 12px;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 0.875rem;
  }

  .techs { display: flex; gap: 4px; flex-wrap: wrap; margin-top: auto; }

  .tech {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #64748b;
    background: #0d0f14;
    border: 0.5px solid #252a35;
    padding: 1px 6px;
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 20);
  });
</script>